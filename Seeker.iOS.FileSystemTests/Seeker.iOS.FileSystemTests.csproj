<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RootNamespace>AnimaSeek.iOS.FileSystemTests</RootNamespace>
    <AssemblyName>AnimaSeek.FileSystemTests</AssemblyName>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationTitle>AnimaSeek File-System Tests</ApplicationTitle>
    <ApplicationId>com.animaseek.filesystemtests</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <!-- Compile the production implementation itself so the simulator smoke cannot
         silently diverge behind a test double or copied implementation. -->
    <Compile Include="..\Seeker.iOS\Services\IosFileSystemService.cs"
             Link="Production\IosFileSystemService.cs" />
    <Compile Include="..\Seeker.iOS\Services\IosDownloadFinalizationJournal.cs"
             Link="Production\IosDownloadFinalizationJournal.cs" />
    <Compile Include="..\Seeker.iOS\Services\UserDefaultsKeyValueStore.cs"
             Link="Production\UserDefaultsKeyValueStore.cs" />
  </ItemGroup>
</Project>
