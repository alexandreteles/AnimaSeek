<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AndroidResgenFile>Resources\Resource.designer.cs</AndroidResgenFile>
    <AndroidHttpClientHandlerType>Xamarin.Android.Net.AndroidMessageHandler</AndroidHttpClientHandlerType>
    <AndroidAapt2LinkExtraArgs>--no-version-vectors</AndroidAapt2LinkExtraArgs>
    <MonoSymbolArchive>true</MonoSymbolArchive>
    <AndroidManagedSymbols>true</AndroidManagedSymbols>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.animaseek.app</ApplicationId>
    <ApplicationTitle>AnimaSeek</ApplicationTitle>
    <AssemblyTitle>AnimaSeek</AssemblyTitle>
    <Product>AnimaSeek</Product>
    <Copyright>Copyright ©  2018</Copyright>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
	<Configurations>Debug;Debug Mock;Release;Release Mock</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
    <EnableLLVM>false</EnableLLVM>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <MandroidI18n />
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <RuntimeIdentifiers>android-arm;android-x86;android-x64;android-arm64</RuntimeIdentifiers>
    <DefineConstants>TRACE;ADB_LOGCAT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug Mock|AnyCPU' ">
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
    <EnableLLVM>false</EnableLLVM>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <MandroidI18n />
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <RuntimeIdentifiers>android-arm;android-x86;android-x64;android-arm64</RuntimeIdentifiers>
    <DefineConstants>DEBUG;MOCK;TRACE;ADB_LOGCAT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <AndroidProguardMappingFile>$(OutputPath)mapping.txt</AndroidProguardMappingFile>
    <AndroidUseSharedRuntime>False</AndroidUseSharedRuntime>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <MonoSymbolArchive>True</MonoSymbolArchive>
    <AndroidNativeDebugSymbolCompressionFormat>zip</AndroidNativeDebugSymbolCompressionFormat>
    <RuntimeIdentifiers>android-arm;android-x86;android-x64;android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release Mock|AnyCPU' ">
    <AndroidProguardMappingFile>$(OutputPath)mapping.txt</AndroidProguardMappingFile>
    <AndroidUseSharedRuntime>False</AndroidUseSharedRuntime>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <MonoSymbolArchive>True</MonoSymbolArchive>
    <RuntimeIdentifiers>android-arm;android-x86;android-x64;android-arm64</RuntimeIdentifiers>
    <DefineConstants>MOCK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
	<AndroidKeyStore>true</AndroidKeyStore>
	<AndroidSigningKeyStore>$(AndroidSigningKeyStore)</AndroidSigningKeyStore>
	<AndroidSigningKeyAlias>$(AndroidSigningKeyAlias)</AndroidSigningKeyAlias>
	<AndroidSigningKeyPass>$(AndroidSigningKeyPass)</AndroidSigningKeyPass>
	<AndroidSigningStorePass>$(AndroidSigningStorePass)</AndroidSigningStorePass>
  </PropertyGroup>
	<ItemGroup>
    <GoogleServicesJson Include="google-services.json" Condition="Exists('google-services.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.Firebase.Crashlytics" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" />
    <PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" />
    <PackageReference Include="Xamarin.Google.Android.Material" />
    <PackageReference Include="Xamarin.AndroidX.Legacy.Support.Core.Utils" />
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" />
    <PackageReference Include="Xamarin.AndroidX.CoordinatorLayout" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <!-- https://github.com/dotnet/android-libraries/issues/1341 - .Jvm and .Android both contain Immutable.class -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="Mono.Nat-master\Mono.Nat\Mono.Nat.csproj" />
    <ProjectReference Include="Soulseek.NET-master\src\Soulseek_Source.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Mono.Nat-master\**" />
    <Compile Remove="Soulseek.NET-master\**" />
  </ItemGroup>
  <PropertyGroup />
  <Target Name="GenerateDebugSecrets" BeforeTargets="CoreCompile"
          Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Debug Mock'">
    <PropertyGroup>
      <_SeekerDebugCaptureKey>$([System.Environment]::GetEnvironmentVariable('SeekerEncryptKey'))</_SeekerDebugCaptureKey>
      <_DebugSecretsFile>$(IntermediateOutputPath)DebugSecrets.g.cs</_DebugSecretsFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <_DebugSecretsLines Include="// &lt;auto-generated&gt; Regenerated from SEEKER_DEBUG_CAPTURE_KEY. Do not edit." />
      <_DebugSecretsLines Include="namespace Seeker.Debug" />
      <_DebugSecretsLines Include="{" />
      <_DebugSecretsLines Include="    internal static class DebugSecrets" />
      <_DebugSecretsLines Include="    {" />
      <_DebugSecretsLines Include="        public const string SeekerEncryptKey = &quot;$(SeekerEncryptKey)&quot;%3B" />
      <_DebugSecretsLines Include="    }" />
      <_DebugSecretsLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_DebugSecretsFile)" Lines="@(_DebugSecretsLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_DebugSecretsFile)" />
      <FileWrites Include="$(_DebugSecretsFile)" />
    </ItemGroup>
  </Target>
</Project>
